{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://munin-memory.gille.ai/contracts/backup-dependency/v1/schema.json",
  "title": "Munin Memory external backup dependency contract v1",
  "description": "Public-safe workload/dependency extension for the Grimnir node/substrate v1 boundary. Private endpoints, paths and credentials remain in owner overlays.",
  "oneOf": [
    { "$ref": "#/$defs/backup-dependency" },
    { "$ref": "#/$defs/backup-target-evidence" },
    { "$ref": "#/$defs/backup-run-evidence" },
    { "$ref": "#/$defs/restore-evidence" }
  ],
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,62}$" },
    "utc": { "type": "string", "format": "date-time" },
    "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "backup-dependency": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "schema_version", "node_substrate_contract", "workload_id", "dependency_id", "target", "snapshot", "transfer", "storage", "verification", "failure_behavior", "offsite"],
      "properties": {
        "kind": { "const": "backup-dependency" }, "schema_version": { "const": "v1" }, "node_substrate_contract": { "const": "grimnir.node-substrate/v1" }, "workload_id": { "const": "munin-memory" }, "dependency_id": { "$ref": "#/$defs/id" },
        "target": { "type": "object", "additionalProperties": false, "required": ["target_id", "logical_storage_role", "authentication_boundary"], "properties": { "target_id": { "$ref": "#/$defs/id" }, "logical_storage_role": { "const": "near-site-backup" }, "authentication_boundary": { "const": "owner-overlay" } } },
        "snapshot": { "type": "object", "additionalProperties": false, "required": ["consistency", "expected_size_mib", "cadence_seconds", "timeout_seconds"], "properties": { "consistency": { "const": "sqlite-online-backup" }, "expected_size_mib": { "type": "integer", "minimum": 1 }, "cadence_seconds": { "type": "integer", "minimum": 1 }, "timeout_seconds": { "type": "integer", "minimum": 1 } } },
        "transfer": { "type": "object", "additionalProperties": false, "required": ["minimum_throughput_mibps", "window_seconds"], "properties": { "minimum_throughput_mibps": { "type": "integer", "minimum": 1 }, "window_seconds": { "type": "integer", "minimum": 1 } } },
        "storage": { "type": "object", "additionalProperties": false, "required": ["minimum_free_mib", "write_guarantee"], "properties": { "minimum_free_mib": { "type": "integer", "minimum": 1 }, "write_guarantee": { "const": "verified-size-and-sha256" } } },
        "verification": { "type": "object", "additionalProperties": false, "required": ["integrity", "restore_cadence_seconds", "restore_max_age_seconds"], "properties": { "integrity": { "const": "sqlite-integrity-check" }, "restore_cadence_seconds": { "type": "integer", "minimum": 1 }, "restore_max_age_seconds": { "type": "integer", "minimum": 1 } } },
        "failure_behavior": { "type": "object", "additionalProperties": false, "required": ["target_offline", "stale_evidence", "interrupted_transfer", "target_relocated"], "properties": { "target_offline": { "const": "blocked" }, "stale_evidence": { "const": "blocked" }, "interrupted_transfer": { "const": "retain-prior-verified-copy-and-block" }, "target_relocated": { "const": "require-new-target-id-and-fresh-preflight" } } },
        "offsite": { "type": "object", "additionalProperties": false, "required": ["independent_from_near_site", "encryption"], "properties": { "independent_from_near_site": { "const": true }, "encryption": { "const": "client-side" } } }
      }
    },
    "backup-target-evidence": { "type": "object", "additionalProperties": false, "required": ["kind", "schema_version", "dependency_id", "target_id", "observed_at", "valid_until", "free_mib", "write_probe", "throughput_mibps", "evidence_digest"], "properties": { "kind": { "const": "backup-target-evidence" }, "schema_version": { "const": "v1" }, "dependency_id": { "$ref": "#/$defs/id" }, "target_id": { "$ref": "#/$defs/id" }, "observed_at": { "$ref": "#/$defs/utc" }, "valid_until": { "$ref": "#/$defs/utc" }, "free_mib": { "type": "integer", "minimum": 0 }, "write_probe": { "const": "verified" }, "throughput_mibps": { "type": "integer", "minimum": 0 }, "evidence_digest": { "$ref": "#/$defs/digest" } } },
    "backup-run-evidence": { "type": "object", "additionalProperties": false, "required": ["kind", "schema_version", "dependency_id", "target_id", "completed_at", "outcome", "snapshot_consistency", "integrity", "copy_verification", "transfer_seconds", "evidence_digest"], "properties": { "kind": { "const": "backup-run-evidence" }, "schema_version": { "const": "v1" }, "dependency_id": { "$ref": "#/$defs/id" }, "target_id": { "$ref": "#/$defs/id" }, "completed_at": { "$ref": "#/$defs/utc" }, "outcome": { "enum": ["success", "timed_out", "interrupted", "failed"] }, "snapshot_consistency": { "const": "sqlite-online-backup" }, "integrity": { "enum": ["passed", "failed"] }, "copy_verification": { "enum": ["passed", "failed", "not_completed"] }, "transfer_seconds": { "type": "integer", "minimum": 0 }, "evidence_digest": { "$ref": "#/$defs/digest" } } },
    "restore-evidence": { "type": "object", "additionalProperties": false, "required": ["kind", "schema_version", "dependency_id", "target_id", "restored_at", "outcome", "representative_data", "evidence_digest"], "properties": { "kind": { "const": "restore-evidence" }, "schema_version": { "const": "v1" }, "dependency_id": { "$ref": "#/$defs/id" }, "target_id": { "$ref": "#/$defs/id" }, "restored_at": { "$ref": "#/$defs/utc" }, "outcome": { "enum": ["passed", "failed"] }, "representative_data": { "const": "verified" }, "evidence_digest": { "$ref": "#/$defs/digest" } } }
  }
}
